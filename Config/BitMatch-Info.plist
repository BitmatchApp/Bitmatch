<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle updates (Mac). Xcode's generated Info.plist ignores
	     non-Apple INFOPLIST_KEY_* settings, so these live here and are
	     merged with the generated keys. -->
	<key>SUFeedURL</key>
	<string>https://bitmatchapp.github.io/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>REPLACE_WITH_PUBLIC_ED_KEY</string>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUAutomaticallyUpdate</key>
	<false/>
</dict>
</plist>
